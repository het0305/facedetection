# Copy to backend/.env and fill in. Never commit the real .env.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"         # BIOMETRIC_KEY

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/faceattendance

# Signs admin/kiosk session cookies. Changing it signs everyone out.
JWT_SECRET=
# Encrypts face templates at rest (AES-256-GCM). BACK THIS UP.
# If it is lost, every person must be registered again.
BIOMETRIC_KEY=

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the frontend is served from the same origin (dev proxy / build).
CORS_ORIGINS=
TRUST_PROXY=false
# auto = Secure cookies only in production (requires HTTPS)
COOKIE_SECURE=auto
ADMIN_SESSION_HOURS=8
KIOSK_SESSION_DAYS=30

# Attendance day boundaries and "late" are evaluated in this IANA time zone.
APP_TIMEZONE=Asia/Kolkata
# Optional HH:MM; check-ins after this local time are marked "Late".
LATE_AFTER=
ATTENDANCE_COOLDOWN_SEC=60

# ---- Recognition (face-api 128-d descriptors, Euclidean distance) ----------
# Calibrate with `npm run evaluate -- <dataset>` before production use.
RECOGNITION_THRESHOLD=0.5
HIGH_CONFIDENCE_THRESHOLD=0.4
RECOGNITION_MIN_MARGIN=0.06
MATCH_STRATEGY=min
DUPLICATE_FACE_THRESHOLD=0.42
STABLE_FRAMES=3

# ---- Face quality -----------------------------------------------------------
MIN_FACE_SIZE_PX=90
ENROLL_MIN_FACE_SIZE_PX=110
MIN_SHARPNESS=20
MIN_BRIGHTNESS=55
MAX_BRIGHTNESS=205
MAX_YAW=0.35
MAX_ROLL_DEG=20

# ---- Liveness ---------------------------------------------------------------
# Calibrate with `npm run evaluate-liveness -- --live <dir> --spoof <dir>`.
LIVENESS_ENABLED=true
LIVENESS_THRESHOLD=0.6
REGISTRATION_REQUIRE_LIVENESS=true
CHALLENGE_ENABLED=true
# turn_left, turn_right, blink (enable blink only after testing it on your camera)
CHALLENGE_TYPES=turn_left,turn_right

# auto = native TensorFlow if @tensorflow/tfjs-node is installed, else WASM
FACE_BACKEND=auto
LOG_LEVEL=info
